# Copiez ce fichier vers .env puis collez VOS clés.
# Ne commitez jamais .env. L'application refuse de deviner un endpoint.

# --- Have I Been Pwned (hibp-api-key) ---
# https://haveibeenpwned.com/API/v3
HIBP_API_KEY=
HIBP_USER_AGENT=7O2-OXYGEN

# --- XposedOrNot (seulement pour les domaines vérifiés) ---
# E-mail : pas de clé. Domaine : x-api-key
XPOSEDORNOT_API_KEY=

# --- LeakCheck Pro (l'API publique marche sans clé) ---
# https://leakcheck.io/
LEAKCHECK_API_KEY=

# --- BreachDirectory ---
# https://breachdirectory.org/
BREACHDIRECTORY_API_KEY=

# --- Hudson Rock ---
# https://www.hudsonrock.com/
HUDSONROCK_API_KEY=

# --- IntelX ---
# https://intelx.io/
INTELX_API_KEY=

# --- HackCheck ---
# https://hackcheck.io/
HACKCHECK_API_KEY=

# --- LeakRadar ---
# https://leakradar.io/
LEAKRADAR_API_KEY=

# --- OSINTLeak ---
# https://osintleak.com/
OSINTLEAK_API_KEY=

# --- Enzoic ---
# https://www.enzoic.com/
ENZOIC_API_KEY=
ENZOIC_API_SECRET=

# --- DeHashed ---
# https://dehashed.com/
DEHASHED_EMAIL=
DEHASHED_API_KEY=

# --- Snusbase ---
# https://snusbase.com/
SNUSBASE_API_KEY=

# --- Leak-Lookup ---
# https://leak-lookup.com/
LEAKLOOKUP_API_KEY=

# --- ProxyNova (pas de clé) ---
# https://www.proxynova.com/

# --- BrixHub (config libre) ---
# URL préremplie, vous pouvez la changer
BRIXHUB_URL=https://api.brixhub.ru/api/v1/search
BRIXHUB_API_KEY=

# --- see-know (scraper, login Discord) ---
# Pas de clé, session locale
